# IBVAP Environment Configuration Example
HOST=127.0.0.1
PORT=8000
DATABASE_URL=sqlite:///./ibvap.db
IBVAP_JWT_SECRET=replace-with-secure-production-jwt-secret
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Master AES-256 Key (Base64 encoded 32-byte key)
IBVAP_AES_KEY_B64=

# Tactical Command & Control (C2) Integration
C2_WEBHOOK_URL=http://127.0.0.1:8000/api/c2/mock-webhook

# AI Pipeline Options
AI_CONFIDENCE_THRESHOLD=0.50
RULE_ENGINE_INTERVAL_SECONDS=25
